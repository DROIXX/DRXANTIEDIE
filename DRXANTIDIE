-- SAVE / LOAD
-- ============================================================
local function saveConfig()
    local data = {
        Enabled = Config.Enabled,
        Keybind = Config.Keybind and Config.Keybind.Name or "RightShift",
        SmokeItOff = Config.SmokeItOff,
        IsMobileMode = Config.IsMobileMode,
        MobileUIScale = Config.MobileUIScale,
    }
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadConfig()
    if not isfile or not isfile(CONFIG_FILE) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or not data then return end

    if data.Enabled ~= nil then Config.Enabled = data.Enabled end
    if data.Keybind and Enum.KeyCode[data.Keybind] then
        Config.Keybind = Enum.KeyCode[data.Keybind]
    end
    if data.SmokeItOff ~= nil then Config.SmokeItOff = data.SmokeItOff end
    if data.IsMobileMode ~= nil then Config.IsMobileMode = data.IsMobileMode end
    if data.MobileUIScale then
        Config.MobileUIScale = math.clamp(tonumber(data.MobileUIScale) or 100, 50, 150)
    end
end

