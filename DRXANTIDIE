local SmokeItOff = { sound = nil, isPlaying = false }
function SmokeItOff:ensureSound()
    if not self.sound or not self.sound.Parent then
        self.sound = Instance.new("Sound")
        self.sound.Name = "RadiantSmokeItOff"
        self.sound.SoundId = SMOKE_IT_OFF_ID
        self.sound.Looped = true
        self.sound.Volume = 0.5
        self.sound.Parent = SoundService
    end
    return self.sound
end
function SmokeItOff:play()
    if not Config.SmokeItOff then return end
    local s = self:ensureSound()
    if not s.IsPlaying then s:Play(); self.isPlaying = true end
end
function SmokeItOff:stop()
    if self.sound and self.sound.IsPlaying then self.sound:Stop() end
    self.isPlaying = false
end

