    smokeButton.Name = "SmokeButton"
    smokeButton.ZIndex = 6
    smokeButton.Size = UDim2.new(1, 0, 1, 0)
    smokeButton.BackgroundTransparency = 1
    smokeButton.Text = ""
    smokeButton.AutoButtonColor = false
    smokeButton.Parent = smokeContainer

    -- ===== BIG STATUS BUTTON =====
    local statusButton = Instance.new("TextButton")
    statusButton.Name = "StatusButton"
    statusButton.ZIndex = 5
    statusButton.AnchorPoint = Vector2.new(0, 1)
    statusButton.Position = UDim2.new(0, 18, 1, -14)
    statusButton.Size = UDim2.new(1, -36, 0, 54)
    statusButton.BackgroundColor3 = Color3.fromRGB(15, 30, 15)
    statusButton.BackgroundTransparency = 0.15
    statusButton.Text = "DISABLED"
    statusButton.TextColor3 = GRAY
    statusButton.TextSize = 22
    statusButton.Font = Enum.Font.GothamBlack
    statusButton.AutoButtonColor = false
    statusButton.Parent = mainFrame
    addCorner(statusButton, UDim.new(0, 14))
    addStroke(statusButton, ROW_BORDER, 1.5)

    -- ============================================================
    -- KEYBIND LOGIC
    -- ============================================================
    local isBinding = false

    local function startBinding()
        isBinding = true
        keybindBtn.Text = "..."
        keybindBtn.BackgroundColor3 = Color3.fromRGB(50, 80, 50)

        local connection
        connection = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                Config.Keybind = input.KeyCode
                isBinding = false
                keybindBtn.Text = Config.Keybind.Name
                keybindBtn.BackgroundColor3 = Color3.fromRGB(30, 50, 30)
                saveConfig()
                connection:Disconnect()
            elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
                Config.Keybind = input.KeyCode
                isBinding = false
                keybindBtn.Text = Config.Keybind.Name
                keybindBtn.BackgroundColor3 = Color3.fromRGB(30, 50, 30)
                saveConfig()
                connection:Disconnect()
            end
        end)
    end

    keybindBtn.MouseButton1Click:Connect(function()
        if not isBinding then startBinding() end
    end)

    -- ============================================================
    -- TOGGLE LOGIC (Anti Die)
    -- ============================================================
    local function updateToggle(state)
        Config.Enabled = state
        if state then
            TweenService:Create(statusButton, TweenInfo.new(0.15), {
                BackgroundColor3 = RADIO_GREEN,
                TextColor3 = Color3.fromRGB(0, 0, 0)
            }):Play()
            if Config.IsMobileMode then
                statusButton.Text = "ACTIVE"
            else
                statusButton.Text = "ENABLED"
            end
            startProtect()
            if Config.SmokeItOff then SmokeItOff:play() end
        else
            TweenService:Create(statusButton, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(15, 30, 15),
                TextColor3 = GRAY
            }):Play()
            if Config.IsMobileMode then
                statusButton.Text = "ACTIVATE"
            else
                statusButton.Text = "DISABLED"
            end
            stopProtect()
            SmokeItOff:stop()
        end
        saveConfig()
    end

    statusButton.MouseButton1Click:Connect(function()
        updateToggle(not Config.Enabled)
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Config.Keybind then
            updateToggle(not Config.Enabled)
        end
    end)

    -- ============================================================
    -- SMOKE IT OFF TOGGLE
    -- ============================================================
    local smokeOn = Config.SmokeItOff
    local function updateSmoke(state)
        smokeOn = state
        Config.SmokeItOff = state
        if state then
            TweenService:Create(smokeToggleBg, TweenInfo.new(0.15), { BackgroundColor3 = RADIO_GREEN }):Play()
            TweenService:Create(smokeIndicator, TweenInfo.new(0.15), {
                Position = UDim2.new(1, -19, 0.5, -8),
                BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            }):Play()
            if Config.Enabled then SmokeItOff:play() end
        else
            TweenService:Create(smokeToggleBg, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(40, 40, 40) }):Play()
            TweenService:Create(smokeIndicator, TweenInfo.new(0.15), {
                Position = UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            }):Play()
            SmokeItOff:stop()
        end
        saveConfig()
    end

    if Config.SmokeItOff then
        smokeToggleBg.BackgroundColor3 = RADIO_GREEN
        smokeIndicator.Position = UDim2.new(1, -19, 0.5, -8)
        smokeIndicator.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    end

    smokeButton.MouseButton1Click:Connect(function()
        updateSmoke(not smokeOn)
    end)

    -- ============================================================
    -- PC / MOBILE MODE SWITCH
    -- ============================================================
    local function setMobileMode(isMobile)
        Config.IsMobileMode = isMobile
        if isMobile then
            hotkeyContainer.Visible = false
            sizeContainer.Visible = true
            mainFrame.Size = UDim2.new(0, 280, 0, 240)
            sizeContainer.Position = UDim2.new(0, 18, 0, 70)
            smokeContainer.Position = UDim2.new(0, 18, 0, 122)
            statusButton.Text = Config.Enabled and "ACTIVE" or "ACTIVATE"
            pcBtn.BackgroundColor3 = Color3.fromRGB(30, 50, 30)
            pcBtn.TextColor3 = Color3.fromRGB(150, 200, 150)
            mobileBtn.BackgroundColor3 = RADIO_GREEN
            mobileBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
            mobileScale.Scale = Config.MobileUIScale / 100
        else
            hotkeyContainer.Visible = true
            sizeContainer.Visible = false
            mainFrame.Size = UDim2.new(0, 300, 0, 300)
            smokeContainer.Position = UDim2.new(0, 18, 0, 126)
            statusButton.Text = Config.Enabled and "ENABLED" or "DISABLED"
            pcBtn.BackgroundColor3 = RADIO_GREEN
            pcBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
            mobileBtn.BackgroundColor3 = Color3.fromRGB(30, 50, 30)
            mobileBtn.TextColor3 = Color3.fromRGB(150, 200, 150)
            mobileScale.Scale = 1
        end
        saveConfig()
    end

    pcBtn.MouseButton1Click:Connect(function()
        setMobileMode(false)
    end)

    mobileBtn.MouseButton1Click:Connect(function()
        setMobileMode(true)
    end)

    setMobileMode(Config.IsMobileMode)

    if Config.Enabled then
        updateToggle(true)
    end

    makeDraggable(mainFrame)

    return mainGui
end

